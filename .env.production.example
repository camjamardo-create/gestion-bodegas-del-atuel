# Plantilla para docker-compose.production.yml y scripts de despliegue.
# Copiar a .env.production (ignorado por Git) y reemplazar TODOS los valores.
# No usar estos placeholders en un entorno real.

# Dominio publico con DNS al servidor. Caddy emite el certificado HTTPS.
DOMAIN=app.example.com
CORS_ORIGINS=https://app.example.com
API_BASE_URL=/api

# Base de datos. El propietario aplica migraciones; la API usa rol_api.
POSTGRES_DB=bodegas_del_atuel
POSTGRES_USER=bodegas_owner
POSTGRES_PASSWORD=CAMBIAR_POR_SECRETO_GESTIONADO
APP_DB_PASSWORD=CAMBIAR_POR_SECRETO_GESTIONADO
APP_REPORT_PASSWORD=CAMBIAR_POR_SECRETO_GESTIONADO

# En el compose de referencia PostgreSQL tiene TLS interno autofirmado.
# Para un proveedor gestionado usar require (o verify-full con su CA).
DB_SSLMODE=require
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10

# Puertos internos/local de referencia. En produccion el unico puerto publico
# es 80/443 (Caddy); no se publica 5432 ni 8000.
FRONT_PORT=8080

# Variables que usan los scripts desde la maquina de operaciones. No se
# publican ni se guardan en el repositorio. Para migraciones se usa el
# propietario, no rol_api.
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=bodegas_del_atuel
DB_OWNER_USER=bodegas_owner
DB_OWNER_PASSWORD=CAMBIAR_POR_SECRETO_GESTIONADO
DB_USER=rol_api
DB_PASSWORD=CAMBIAR_POR_SECRETO_GESTIONADO
API_PUBLIC_URL=https://app.example.com/api
