# Copiar a .env y completar con valores locales.
# No commitear .env.

# Docker Compose local
POSTGRES_PASSWORD=definir_en_local
POSTGRES_PORT=5433
APP_DB_PASSWORD=definir_en_local
APP_REPORT_PASSWORD=definir_en_local
API_PORT=8000
FRONT_PORT=8080
API_BASE_URL=/api
CORS_ORIGINS=http://localhost:8080

# API ejecutada fuera de Docker (los tests y uvicorn locales).
# Dentro de Docker Compose estas variables las define el servicio api.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bodegas_del_atuel
DB_USER=rol_api
DB_PASSWORD=definir_en_local
# En local, PostgreSQL de Compose no publica TLS. En la nube usar require.
DB_SSLMODE=disable
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10

# Conexion usada por db/seed/cargar_datos.py y db/seed/generar_dump.sh.
# Opcion 1: cadena completa.
DATABASE_URL=postgresql://postgres:definir_en_local@localhost:5433/bodegas_del_atuel

# Opcion 2: variables PG* (si no se define DATABASE_URL).
# PGHOST=localhost
# PGPORT=5433
# PGUSER=postgres
# PGPASSWORD=definir_en_local
# PGDATABASE=bodegas_del_atuel
# PGSSLMODE=disable
