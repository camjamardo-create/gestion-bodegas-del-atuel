# Copiar a .env y completar con valores locales.
# No commitear .env.

# Docker Compose
POSTGRES_PASSWORD=definir_en_local
POSTGRES_PORT=5433
APP_DB_PASSWORD=definir_en_local
API_PORT=8000

# API ejecutada fuera de Docker (los tests y uvicorn locales).
# Dentro de Docker Compose estas variables las define el servicio api.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bodegas_del_atuel
DB_USER=rol_api
DB_PASSWORD=definir_en_local
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10

# Conexión usada por db/seed/cargar_datos.py y db/seed/generar_dump.sh.
# Opción 1: cadena completa.
DATABASE_URL=postgresql://postgres:definir_en_local@localhost:5433/bodegas_del_atuel

# Opción 2: variables PG* (si no se define DATABASE_URL).
# PGHOST=localhost
# PGPORT=5433
# PGUSER=postgres
# PGPASSWORD=definir_en_local
# PGDATABASE=bodegas_del_atuel
